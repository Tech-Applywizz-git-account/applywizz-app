# Place Firebase `google-services.json` here for Android EAS / Play Store builds.
# Download from Firebase Console → Project settings → Your apps → Android
# (package name must be com.invoices.app).
#
# `app.config.js` auto-includes it when this file exists.
# Rebuild the native app after adding it — Expo Go cannot receive FCM.
#
# Do not commit the Django service-account private key.
# Only this client google-services.json belongs in app/mobile/.
